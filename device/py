#!/system/bin/sh
# Launcher for the static CPython build on Android 5.1 / LineageOS 6.0
# (Samsung Galaxy J1 mini, SM-J105H / SM-J05H).
# Generated by .github/workflows/build.yml - keep LF line endings.
#
# This is what `python`, `python3`, `py` and `pip` on PATH point at.

PYHOME=/data/local/tmp/pyhome

export PYTHONHOME="$PYHOME"
export HOME=/data/local/tmp/pyhome-home
export TMPDIR=/data/local/tmp
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
unset PYTHONPATH

# OpenSSL was configured with --openssldir=$PYHOME/ssl, so its built-in CA
# file is $PYHOME/ssl/cert.pem. Build it once out of Android's CA store:
# Android names its CA files with a hash format OpenSSL 3.x will not match
# when walking a capath, but a plain PEM bundle works. Naming it cert.pem
# means even the bare pyhome/bin/python3.11 finds it, with no environment.
CACERTS=/system/etc/security/cacerts
BUNDLE="$PYHOME/ssl/cert.pem"
if [ -d "$CACERTS" ] && [ ! -f "$BUNDLE" ]; then
    mkdir -p "$PYHOME/ssl" 2>/dev/null
    cat "$CACERTS"/*.0 > "$BUNDLE" 2>/dev/null
    chmod 755 "$PYHOME/ssl" 2>/dev/null
    chmod 644 "$BUNDLE" 2>/dev/null
fi
if [ -f "$BUNDLE" ]; then
    export SSL_CERT_FILE="$BUNDLE"
    unset SSL_CERT_DIR
fi

# Time zones. The tzdata package carries a full TZif tree; PYTHONTZPATH points
# zoneinfo at it, and TZ tells musl which file /etc/localtime should be, so
# time.localtime() stops returning UTC. Android has neither. Change the zone
# by editing /data/local/tmp/tz (any name from the tz database, e.g.
# Europe/Berlin, Asia/Almaty, America/New_York).
ZONEINFO="$PYHOME/lib/python3.11/site-packages/tzdata/zoneinfo"
TZFILE=/data/local/tmp/tz
if [ -d "$ZONEINFO" ]; then
    export PYTHONTZPATH="$ZONEINFO"
    if [ ! -r "$TZFILE" ]; then
        echo "Europe/Moscow" > "$TZFILE" 2>/dev/null
        chmod 644 "$TZFILE" 2>/dev/null
    fi
    ZONE=$(cat "$TZFILE" 2>/dev/null)
    if [ -n "$ZONE" ] && [ -f "$ZONEINFO/$ZONE" ]; then
        export TZ=":$ZONEINFO/$ZONE"
    fi
fi

mkdir -p "$HOME" 2>/dev/null

exec "$PYHOME/bin/python3.11" "$@"