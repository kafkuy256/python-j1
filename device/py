#!/system/bin/sh
# Launcher for the static CPython build on Android 5.1 (SM-J105H).
# Generated by .github/workflows/build.yml - keep LF line endings.

PYHOME=/data/local/tmp/pyhome

export PYTHONHOME="$PYHOME"
export HOME=/data/local/tmp/pyhome-home
export TMPDIR=/data/local/tmp
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
unset PYTHONPATH
unset SSL_CERT_FILE
unset SSL_CERT_DIR

mkdir -p "$HOME" 2>/dev/null

exec "$PYHOME/bin/python3.11" "$@"
